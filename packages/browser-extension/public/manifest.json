{
  "name": "FinTrack Portfolio",
  "short_name": "FinTrack",
  "description": "View your investment portfolio summary from the browser toolbar",
  "version": "0.1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open FinTrack Investments",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.bibit.id/*"],
      "js": ["bibit-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.bibit.id/*"],
      "js": ["bibit-content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://fintrek.web.id/*",
    "https://app.bibit.id/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}